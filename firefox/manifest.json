{
  "manifest_version": 3,
  "name": "YT+",
  "version": "1.3.0",
  "description": "Distraction removal, playback defaults and an ambient glow for YouTube.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT+",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "src/page.css"
      ],
      "js": [
        "src/settings.js",
        "src/content.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/embed/*"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "css": [
        "src/page.css"
      ],
      "js": [
        "src/settings.js",
        "src/content.js",
        "src/ambient.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "src/player.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "src/live-chat.css"
      ],
      "exclude_matches": [
        "https://www.youtube.com/live_chat?is_popout=1*",
        "https://www.youtube.com/live_chat_replay?is_popout=1*"
      ]
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ytplus@shvmane.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
